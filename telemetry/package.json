{
  "name": "innerdesk-telemetry",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "Anonymous install ping + crash ingest for InnerDesk (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute innerdesk-telemetry --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute innerdesk-telemetry --local --file=./schema.sql"
  },
    "devDependencies": {
      "@cloudflare/workers-types": "4.20250815.0",
      "typescript": "^5.8.3",
      "wrangler": "4.37.1"
    }
}
